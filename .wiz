# vim: ft=yaml

ignore:
  vulnerabilities:
    ALL:
      /.webpack/*: {}
      /.webpack/**/*: {}
      /flywheel/**/*: {}
      /karma.conf.js: {}
      /**/karma.conf.js: {}
      /packages/docs/*: {}
      /packages/docs/**/*: {}
      /packages/*/examples/**/*: {}
      /packages/*/karma.conf.js: {}
      /publish-version.mjs: {}
      /scripts/*: {}
      /scripts/**/*: {}
      /utils/*: {}
      /utils/**/*: {}
  sast:
    ALL:
      /.webpack/*: {}
      /.webpack/**/*: {}
      /flywheel/**/*: {}
      /karma.conf.js: {}
      /**/karma.conf.js: {}
      /packages/docs/*: {}
      /packages/docs/**/*: {}
      /packages/*/examples/**/*: {}
      /packages/*/karma.conf.js: {}
      /publish-version.mjs: {}
      /scripts/*: {}
      /scripts/**/*: {}
      /utils/*: {}
      /utils/**/*: {}
